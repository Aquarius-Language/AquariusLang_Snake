變數 規則 = 匯入("遊戲規則.aqua");
變數 通過數 = 0;
變數 驗證 = 函式(條件, 名稱) {
    如果 (!條件) { 印出("驗證失敗：", 名稱); 回傳 未通過的驗證; }
    通過數++;
};
變數 場景 = 函式(蛇身, 方向, 果實, 寬, 高, 穿牆) {
    回傳 {"寬": 寬, "高": 高, "速度": 1, "穿牆": 穿牆, "蛇身": 蛇身, "方向": 方向,
        "佇列": [], "果實": 果實, "分數": 0, "狀態": "進行", "原因": "", "種子": 812};
};
變數 局面 = 規則.新遊戲(20, 20, 1, 假, 42);
驗證(局面["狀態"] == "準備", "新局等待開始");
驗證(長度(局面["蛇身"]) == 4, "初始蛇身四節");
驗證(!規則.佔用位置(局面["蛇身"], 局面["果實"][0], 局面["果實"][1], 4), "初始果實避開蛇身");
驗證(規則.步進(局面) == 局面, "準備時不移動");
局面 = 規則.開始(局面);
驗證(局面["狀態"] == "進行", "開始遊戲");
變數 下局 = 規則.步進(局面);
驗證(下局["蛇身"][0][0] == 11 && 局面["蛇身"][0][0] == 10, "移動且保留原局面");
驗證(長度(下局["蛇身"]) == 4, "沒有果實時維持長度");
驗證(長度((規則.轉向(局面, 3))["佇列"]) == 0, "阻止直接反向");
驗證(長度((規則.轉向(局面, 1))["佇列"]) == 0, "忽略相同方向");
變數 轉彎局 = 規則.轉向(局面, 0);
轉彎局 = 規則.轉向(轉彎局, 3);
驗證(長度(轉彎局["佇列"]) == 2, "保留兩次快速轉彎");
驗證(長度((規則.轉向(轉彎局, 2))["佇列"]) == 2, "輸入佇列有上限");
轉彎局 = 規則.步進(轉彎局);
驗證(轉彎局["方向"] == 0 && 轉彎局["蛇身"][0][1] == 9, "第一步向上");
轉彎局 = 規則.步進(轉彎局);
驗證(轉彎局["方向"] == 3 && 轉彎局["蛇身"][0][0] == 9, "第二步向左");
變數 反向局 = 規則.轉向(規則.轉向(局面, 0), 2);
驗證(長度(反向局["佇列"]) == 1, "阻止相對待執行方向反向");
變數 暫停局 = 規則.暫停切換(局面);
驗證(暫停局["狀態"] == "暫停", "暫停遊戲");
驗證(規則.步進(暫停局) == 暫停局, "暫停時不移動");
驗證(規則.轉向(暫停局, 0) == 暫停局, "暫停時不累積輸入");
驗證((規則.暫停切換(暫停局))["狀態"] == "進行", "恢復遊戲");
變數 吃果局 = 場景([[3, 3], [2, 3], [1, 3], [0, 3]], 1, [4, 3], 20, 20, 假);
吃果局 = 規則.步進(吃果局);
驗證(吃果局["分數"] == 10 && 長度(吃果局["蛇身"]) == 5, "吃果實加十分並成長");
驗證(!規則.佔用位置(吃果局["蛇身"], 吃果局["果實"][0], 吃果局["果實"][1], 5), "新果實不在蛇身上");
變數 撞牆局 = 場景([[19, 3], [18, 3], [17, 3], [16, 3]], 1, [1, 1], 20, 20, 假);
撞牆局 = 規則.步進(撞牆局);
驗證(撞牆局["狀態"] == "結束" && 撞牆局["原因"] == "撞到邊界", "撞右牆結束");
驗證(規則.步進(撞牆局) == 撞牆局, "結束後不繼續移動");
驗證(規則.開始(撞牆局) == 撞牆局, "結束後需建立新局");
變數 穿牆局 = 場景([[19, 3], [18, 3], [17, 3], [16, 3]], 1, [1, 1], 20, 20, 真);
穿牆局 = 規則.步進(穿牆局);
驗證(穿牆局["蛇身"][0][0] == 0 && 穿牆局["狀態"] == "進行", "穿越右邊界");
穿牆局 = 場景([[0, 3], [1, 3], [2, 3], [3, 3]], 3, [1, 1], 20, 20, 真);
驗證((規則.步進(穿牆局))["蛇身"][0][0] == 19, "穿越左邊界");
穿牆局 = 場景([[3, 0], [3, 1], [3, 2], [3, 3]], 0, [1, 1], 20, 20, 真);
驗證((規則.步進(穿牆局))["蛇身"][0][1] == 19, "穿越上邊界");
穿牆局 = 場景([[3, 19], [3, 18], [3, 17], [3, 16]], 2, [1, 1], 20, 20, 真);
驗證((規則.步進(穿牆局))["蛇身"][0][1] == 0, "穿越下邊界");
變數 自撞局 = 場景([[2, 2], [2, 3], [3, 3], [3, 2], [3, 1]], 1, [1, 1], 20, 20, 假);
驗證((規則.步進(自撞局))["原因"] == "碰到自己", "碰到身體結束");
變數 尾巴局 = 場景([[2, 2], [2, 3], [3, 3], [3, 2]], 1, [1, 1], 20, 20, 假);
驗證((規則.步進(尾巴局))["狀態"] == "進行", "可以走進本步離開的尾巴格");
變數 滿盤局 = 場景([[0, 0], [0, 1], [1, 1]], 1, [1, 0], 2, 2, 假);
滿盤局 = 規則.步進(滿盤局);
驗證(滿盤局["狀態"] == "勝利" && 長度(滿盤局["果實"]) == 0, "吃到最後一格宣告勝利");
驗證(規則.步進(滿盤局) == 滿盤局, "勝利後不再產生移動");
驗證((規則.產生果實([[0, 0], [0, 1], [1, 1]], 2, 2, 99))[0][0] == 1, "只剩一空格時必定選中");
變數 快速局 = 規則.建立狀態(局面, 局面["蛇身"], 1, [], 局面["果實"], 3960, "進行", "", 99);
驗證(規則.移動間隔(快速局) == 55, "加速仍保留安全下限");
迴圈 (變數 速度 = 0; 速度 < 3; 速度++) {
    驗證(規則.移動間隔(規則.新遊戲(20, 20, 速度, 假, 99)) == [190, 135, 90][速度], "三種初始速度");
}
迴圈 (變數 種子 = 0; 種子 < 100; 種子++) {
    變數 果實 = (規則.產生果實([[0, 0], [1, 0], [2, 0], [3, 0]], 20, 20, 種子))[0];
    驗證(果實[0] >= 0 && 果實[0] < 20 && 果實[1] >= 0 && 果實[1] < 20, "果實位於合法格子");
    驗證(!規則.佔用位置([[0, 0], [1, 0], [2, 0], [3, 0]], 果實[0], 果實[1], 4), "果實避開已佔用格子");
}
印出("規則驗證全部通過，共", 通過數, "項。");
真;
