# 原生協定的模組、事件及屬性尚無中文別名，僅此檔集中讀取。
# 所有宣告、函式呼叫及對外介面皆使用繁體中文。
變數 繪圖 = 匯入("Processing");
變數 儲存庫 = 匯入("Storage");
變數 開啟視窗 = 函式() { 繪圖.尺寸(1240, 860, "P2D", "青芽・貪吃蛇"); };
變數 視窗寬度 = 函式() { 回傳 繪圖.width; };
變數 視窗高度 = 函式() { 回傳 繪圖.height; };
變數 滑鼠橫座標 = 函式() { 回傳 繪圖.mouseX; };
變數 滑鼠縱座標 = 函式() { 回傳 繪圖.mouseY; };
變數 按鍵代碼 = 函式() { 回傳 繪圖.keyCode; };
變數 註冊按下 = 函式(處理) { 繪圖.註冊事件("keyPressed", 處理); };
變數 註冊放開 = 函式(處理) { 繪圖.註冊事件("keyReleased", 處理); };
變數 註冊點擊 = 函式(處理) { 繪圖.註冊事件("mousePressed", 處理); };
變數 註冊調整尺寸 = 函式(處理) { 繪圖.註冊事件("windowResized", 處理); };
變數 讀取紀錄 = 函式() {
    變數 紀錄 = [0, 0, 0, 0, 0, 0];
    # 儲存庫的鍵只允許英數字，採固定數字識別碼保存繁體中文遊戲紀錄。
    變數 資料 = 儲存庫.讀取("20261008.31001");
    如果 (資料 != 最後一個([])) {
        如果 (長度(資料) == 13) {
            如果 (資料[0] == 1) {
                迴圈 (變數 項 = 0; 項 < 6; 項++) {
                    變數 分數 = 資料[項 * 2 + 1] * 256 + 資料[項 * 2 + 2];
                    如果 (分數 >= 0 && 分數 <= 3960) { 紀錄[項] = 分數; }
                }
            }
        }
    }
    回傳 紀錄;
};
變數 儲存紀錄 = 函式(紀錄) {
    變數 資料 = [1];
    迴圈 (變數 項 = 0; 項 < 6; 項++) {
        變數 高位 = 紀錄[項] / 256;
        資料 = 加入(資料, 高位);
        資料 = 加入(資料, 紀錄[項] - 高位 * 256);
    }
    儲存庫.寫入("20261008.31001", 資料);
};
