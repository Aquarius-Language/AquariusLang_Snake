# 純繁體中文遊戲規則，桌面與瀏覽器共用同一份位元碼。
變數 餘數 = 函式(數值, 除數) { 回傳 數值 - (數值 / 除數) * 除數; };
變數 相同位置 = 函式(甲, 乙) { 回傳 甲[0] == 乙[0] && 甲[1] == 乙[1]; };
變數 佔用位置 = 函式(蛇身, 橫格, 縱格, 檢查長度) {
    迴圈 (變數 節 = 0; 節 < 檢查長度; 節++) {
        如果 (蛇身[節][0] == 橫格 && 蛇身[節][1] == 縱格) { 回傳 真; }
    }
    回傳 假;
};
變數 產生果實 = 函式(蛇身, 寬, 高, 種子) {
    變數 空格數 = 寬 * 高 - 長度(蛇身);
    如果 (空格數 == 0) { 回傳 [[], 種子]; }
    種子 = 餘數(種子 * 251 + 17, 65521);
    變數 選擇 = 餘數(種子, 空格數);
    迴圈 (變數 縱格 = 0; 縱格 < 高; 縱格++) {
        迴圈 (變數 橫格 = 0; 橫格 < 寬; 橫格++) {
            如果 (!佔用位置(蛇身, 橫格, 縱格, 長度(蛇身))) {
                如果 (選擇 == 0) { 回傳 [[橫格, 縱格], 種子]; }
                選擇 -= 1;
            }
        }
    }
    回傳 [[], 種子];
};
變數 建立狀態 = 函式(舊局面, 蛇身, 方向, 佇列, 果實, 分數, 狀態, 原因, 種子) {
    回傳 {"寬": 舊局面["寬"], "高": 舊局面["高"], "速度": 舊局面["速度"], "穿牆": 舊局面["穿牆"],
        "蛇身": 蛇身, "方向": 方向, "佇列": 佇列, "果實": 果實, "分數": 分數, "狀態": 狀態, "原因": 原因, "種子": 種子};
};
變數 改變狀態 = 函式(局面, 狀態) {
    回傳 建立狀態(局面, 局面["蛇身"], 局面["方向"], 局面["佇列"], 局面["果實"], 局面["分數"], 狀態, 局面["原因"], 局面["種子"]);
};
變數 新遊戲 = 函式(寬, 高, 速度, 穿牆, 種子) {
    變數 中橫 = 寬 / 2;
    變數 中縱 = 高 / 2;
    變數 蛇身 = [[中橫, 中縱], [中橫 - 1, 中縱], [中橫 - 2, 中縱], [中橫 - 3, 中縱]];
    變數 果實資料 = 產生果實(蛇身, 寬, 高, 餘數(種子, 65521));
    回傳 {"寬": 寬, "高": 高, "速度": 速度, "穿牆": 穿牆, "蛇身": 蛇身, "方向": 1,
        "佇列": [], "果實": 果實資料[0], "分數": 0, "狀態": "準備", "原因": "", "種子": 果實資料[1]};
};
變數 開始 = 函式(局面) {
    如果 (局面["狀態"] == "準備" || 局面["狀態"] == "暫停") { 回傳 改變狀態(局面, "進行"); }
    回傳 局面;
};
變數 暫停切換 = 函式(局面) {
    如果 (局面["狀態"] == "進行") { 回傳 改變狀態(局面, "暫停"); }
    如果 (局面["狀態"] == "暫停") { 回傳 改變狀態(局面, "進行"); }
    回傳 局面;
};
# 上、右、下、左依序為零、一、二、三；最多保留兩次合法轉彎。
變數 轉向 = 函式(局面, 方向) {
    如果 (局面["狀態"] != "進行") { 回傳 局面; }
    變數 佇列 = 局面["佇列"];
    如果 (長度(佇列) >= 2) { 回傳 局面; }
    變數 最後方向 = 局面["方向"];
    如果 (長度(佇列) > 0) { 最後方向 = 最後一個(佇列); }
    如果 (方向 == 最後方向 || 餘數(方向 + 2, 4) == 最後方向) { 回傳 局面; }
    回傳 建立狀態(局面, 局面["蛇身"], 局面["方向"], 加入(佇列, 方向), 局面["果實"], 局面["分數"], "進行", "", 局面["種子"]);
};
變數 步進 = 函式(局面) {
    如果 (局面["狀態"] != "進行") { 回傳 局面; }
    變數 方向 = 局面["方向"];
    變數 佇列 = 局面["佇列"];
    如果 (長度(佇列) > 0) { 方向 = 佇列[0]; 佇列 = 其餘(佇列); }
    變數 蛇身 = 局面["蛇身"];
    變數 位移 = [[0, -1], [1, 0], [0, 1], [-1, 0]];
    變數 橫格 = 蛇身[0][0] + 位移[方向][0];
    變數 縱格 = 蛇身[0][1] + 位移[方向][1];
    變數 原因 = "";
    如果 (局面["穿牆"]) {
        橫格 = 餘數(橫格 + 局面["寬"], 局面["寬"]);
        縱格 = 餘數(縱格 + 局面["高"], 局面["高"]);
    } 否則如果 (橫格 < 0 || 縱格 < 0 || 橫格 >= 局面["寬"] || 縱格 >= 局面["高"]) { 原因 = "撞到邊界"; }
    變數 吃到 = 相同位置([橫格, 縱格], 局面["果實"]);
    變數 檢查長度 = 長度(蛇身) - 1;
    如果 (吃到) { 檢查長度++; }
    如果 (佔用位置(蛇身, 橫格, 縱格, 檢查長度)) { 原因 = "碰到自己"; }
    如果 (原因 != "") {
        回傳 建立狀態(局面, 蛇身, 方向, [], 局面["果實"], 局面["分數"], "結束", 原因, 局面["種子"]);
    }
    變數 新蛇身 = [[橫格, 縱格]];
    變數 保留長度 = 長度(蛇身) - 1;
    如果 (吃到) { 保留長度++; }
    迴圈 (變數 節 = 0; 節 < 保留長度; 節++) { 新蛇身 = 加入(新蛇身, 蛇身[節]); }
    變數 果實 = 局面["果實"];
    變數 種子 = 局面["種子"];
    變數 分數 = 局面["分數"];
    變數 狀態 = "進行";
    如果 (吃到) {
        分數 += 10;
        變數 資料 = 產生果實(新蛇身, 局面["寬"], 局面["高"], 種子);
        果實 = 資料[0]; 種子 = 資料[1];
        如果 (長度(果實) == 0) { 狀態 = "勝利"; 原因 = "填滿整座花園"; }
    }
    回傳 建立狀態(局面, 新蛇身, 方向, 佇列, 果實, 分數, 狀態, 原因, 種子);
};
變數 移動間隔 = 函式(局面) {
    變數 間隔 = [190, 135, 90][局面["速度"]] - (局面["分數"] / 50) * 4;
    如果 (間隔 < 55) { 間隔 = 55; }
    回傳 間隔;
};
